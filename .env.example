# Base de données PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/presence_iua"

# Port d'écoute du serveur NestJS
PORT=4000

# Secret JWT pour enseignant / étudiant / chef de classe
JWT_SECRET="change-moi-par-une-longue-phrase-aleatoire"

# Secret JWT pour l'administrateur — VOLONTAIREMENT différent de JWT_SECRET.
# Un jeton étudiant ou enseignant ne doit jamais pouvoir ouvrir une route admin.
JWT_ADMIN_SECRET="change-moi-aussi-par-une-autre-longue-phrase-aleatoire"

# Utilisés uniquement par prisma/seed-admin.ts pour créer le premier compte admin
ADMIN_EMAIL="admin@iuaci.org"
ADMIN_PASSWORD="ChangeMoiVite2026!"
ADMIN_FIRSTNAME="Administrateur"
ADMIN_LASTNAME="Principal"
ESTABLISHMENT_NAME="Institut Universitaire d'Abidjan"
